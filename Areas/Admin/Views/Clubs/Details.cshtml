@model clubmanager.ViewModels.ClubDetailsVm
@{  ViewData["Title"]="Chi tiết câu lạc bộ"; var c=Model.Club; }
<main id="main" class="main"><section class="section">
<div class="page-heading"><div><a asp-action="Index" class="back-link"><i class="bi bi-arrow-left"></i> Danh sách câu lạc bộ</a><h1>@c.Name</h1><p>@c.Code · @c.Sport</p></div><div class="d-flex gap-2 flex-wrap"><a asp-area="" asp-controller="ClubRegistration" asp-action="Join" asp-route-clubId="@c.Id" class="btn btn-light border" target="_blank"><i class="bi bi-link-45deg"></i> Form đăng ký</a><a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-primary btn-main"><i class="bi bi-pencil"></i> Chỉnh sửa</a></div></div>
<div class="detail-grid"><section class="panel info-panel"><h2>Thông tin câu lạc bộ</h2><div class="info-list"><div><span>Môn thể thao</span><strong>@c.Sport</strong></div><div><span>Trạng thái</span><span class="status-pill @(c.Status=="Hoạt động"?"status-live":"status-paused")">● @c.Status</span></div><div><span>Địa điểm</span><strong>@(c.Location ?? "Chưa cập nhật")</strong></div><div><span>Lịch sinh hoạt</span><strong>@(c.Schedule ?? "Chưa cập nhật")</strong></div><div><span>Ngày thành lập</span><strong>@c.FoundedOn.ToString("dd/MM/yyyy")</strong></div><div><span>Sức chứa</span><strong>@Model.Members.Count / @c.Capacity</strong></div></div><hr/><h3>Giới thiệu</h3><p class="desc">@(c.Description ?? "Chưa có giới thiệu.")</p><form method="post" asp-action="Delete" asp-route-id="@c.Id" onsubmit="return confirm('Bạn chắc chắn muốn xóa CLB này? Chỉ CLB chưa có thành viên hoặc đơn đăng ký mới được xóa.');"><button class="btn btn-outline-danger btn-sm" type="submit"><i class="bi bi-trash"></i> Xóa câu lạc bộ</button></form></section>
<section class="panel member-panel"><div class="section-head"><div><h2>Thành viên</h2><p>@Model.Members.Count thành viên</p></div><a asp-controller="Members" asp-action="Create" asp-route-clubId="@c.Id" class="btn btn-primary btn-sm"><i class="bi bi-plus"></i> Thêm thành viên</a></div>
<div class="table-responsive"><table class="table club-table"><thead><tr><th>HỌ VÀ TÊN</th><th>MÃ HS / LỚP</th><th>VAI TRÒ</th><th></th></tr></thead><tbody>
@foreach(var m in Model.Members){<tr><td><strong>@m.FullName</strong><small class="d-block text-muted">@m.Email</small></td><td>@m.StudentCode<small class="d-block text-muted">@m.ClassName</small></td><td><span class="role-pill">@m.Role</span></td><td><div class="action-buttons"><a asp-controller="Members" asp-action="Edit" asp-route-id="@m.Id" class="btn btn-sm btn-outline-secondary" title="Sửa"><i class="bi bi-pencil"></i></a><form asp-controller="Members" asp-action="Delete" asp-route-id="@m.Id" method="post" onsubmit="return confirm('Xóa thành viên này?');"><button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa"><i class="bi bi-trash"></i></button></form></div></td></tr>}
@if(!Model.Members.Any()){<tr><td colspan="4" class="text-center text-muted py-4">CLB chưa có thành viên.</td></tr>}
</tbody></table></div></section></div>
<section class="panel mt-4"><div class="section-head"><div><h2>Đơn đăng ký tham gia</h2><p>Duyệt hoặc từ chối yêu cầu từ học sinh.</p></div><span class="status-pill status-paused">@Model.Requests.Count đơn</span></div>
<div class="table-responsive"><table class="table club-table"><thead><tr><th>HỌC SINH</th><th>LỚP</th><th>NGÀY GỬI</th><th>LÝ DO</th><th>TRẠNG THÁI</th><th>THAO TÁC</th></tr></thead><tbody>
@foreach(var r in Model.Requests){<tr><td><strong>@r.FullName</strong><small class="d-block">@r.StudentCode</small></td><td>@r.ClassName</td><td>@r.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td><td class="reason-cell">@r.Message</td><td><span class="status-pill @(r.Status=="Đã duyệt"?"status-live":"status-paused")">@r.Status</span></td><td>@if(r.Status=="Chờ duyệt"){<div class="action-buttons"><form asp-controller="Requests" asp-action="Review" asp-route-id="@r.Id" method="post"><input type="hidden" name="decision" value="Approve"/><button class="btn btn-sm btn-success" type="submit">Duyệt</button></form><form asp-controller="Requests" asp-action="Review" asp-route-id="@r.Id" method="post"><input type="hidden" name="decision" value="Reject"/><button class="btn btn-sm btn-outline-danger" type="submit">Từ chối</button></form></div>}</td></tr>}
@if(!Model.Requests.Any()){<tr><td colspan="6" class="text-center text-muted py-4">Chưa có yêu cầu tham gia.</td></tr>}
</tbody></table></div></section>


</section></main>
