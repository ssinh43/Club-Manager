@model ClubManager.Areas.Admin.Controllers.EventController.EventItemViewModel

@{
    ViewData["Title"] = "Chỉnh sửa sự kiện";
}

<style>
    .event-page-wrap {
        margin-left: 316px;
        padding: 76px 20px 20px 8px;
    }

    .event-main-title {
        font-size: 26px;
        font-weight: 600;
        color: #012970;
        margin-bottom: 10px;
        line-height: 1.25;
    }

    @@media (max-width: 1199px) {
        .event-page-wrap {
            margin-left: 0;
            padding: 76px 12px 20px 12px;
        }
    }
</style>

<div class="event-page-wrap">
    <div class="mb-3">
        <h1 class="event-main-title">Chỉnh sửa sự kiện</h1>
        <a asp-area="Admin" asp-controller="Event" asp-action="Index" class="btn btn-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Danh sách sự kiện
        </a>
    </div>

    <section class="section">
        <div class="card">
            <div class="card-body pt-3">
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">@ViewBag.Error</div>
                }

                <form asp-area="Admin" asp-controller="Event" asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />

                    <div class="mb-3">
                        <label class="form-label">Tên sự kiện</label>
                        <input type="text" name="eventName" class="form-control" value="@Model.EventName" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Thời gian</label>
                        <input type="datetime-local" name="eventDate" class="form-control"
                               value="@(Model.EventDate.HasValue ? Model.EventDate.Value.ToString("yyyy-MM-ddTHH:mm") : "")" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Địa điểm</label>
                        <input type="text" name="location" class="form-control" value="@Model.Location" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Mô tả</label>
                        <textarea name="description" rows="3" class="form-control">@Model.Description</textarea>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save me-1"></i> Lưu thay đổi
                        </button>
                        <a asp-area="Admin" asp-controller="Event" asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Quay lại
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </section>
</div>