@model IEnumerable<clubmanager.Models.Event>

@{
    ViewData["Title"] = "Quản lý sự kiện";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<main id="main" class="main" style="padding-top: 76px;">
    <div class="pagetitle">
        <h1>Quản lý sự kiện</h1>
        <nav>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                <li class="breadcrumb-item active">Sự kiện</li>
            </ol>
        </nav>
    </div>

    <section class="section">
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-body pt-3">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="card-title mb-0">Danh sách sự kiện</h5>
                            <a asp-area="Admin" asp-controller="Event" asp-action="Create" class="btn btn-primary btn-sm">
                                <i class="bi bi-plus-circle me-1"></i> Thêm sự kiện
                            </a>
                        </div>

                        @if (TempData["Success"] != null)
                        {
                            <div class="alert alert-success alert-dismissible fade show" role="alert">
                                <i class="bi bi-check-circle me-1"></i>
                                @TempData["Success"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
                            </div>
                        }

                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th scope="col" style="width: 60px;">#</th>
                                        <th scope="col">Tên sự kiện</th>
                                        <th scope="col">Thời gian</th>
                                        <th scope="col">Địa điểm</th>
                                        <th scope="col">Mô tả</th>
                                        <th scope="col" class="text-end" style="width: 170px;">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model != null && Model.Any())
                                    {
                                        int index = 1;
                                        foreach (var item in Model)
                                        {
                                            <tr>
                                                <td>@index</td>
                                                <td class="fw-semibold">@item.EventName</td>
                                                <td>@(item.EventDate.HasValue ? item.EventDate.Value.ToString("dd/MM/yyyy HH:mm") : "—")</td>
                                                <td>@(string.IsNullOrWhiteSpace(item.Location) ? "—" : item.Location)</td>
                                                <td>@(string.IsNullOrWhiteSpace(item.Description) ? "—" : item.Description)</td>
                                                <td class="text-end">
                                                    <a asp-area="Admin" asp-controller="Event" asp-action="Edit" asp-route-id="@item.Id"
                                                       class="btn btn-warning btn-sm me-1" title="Sửa">
                                                        <i class="bi bi-pencil-square"></i>
                                                    </a>
                                                    <form asp-area="Admin" asp-controller="Event" asp-action="Delete" asp-route-id="@item.Id"
                                                          method="post" class="d-inline"
                                                          onsubmit="return confirm('Bạn có chắc muốn xóa sự kiện này?');">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-danger btn-sm" title="Xóa">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </form>
                                                </td>
                                            </tr>
                                            index++;
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="6" class="text-center text-muted py-4">
                                                Chưa có sự kiện nào. Hãy bấm <strong>Thêm sự kiện</strong> để tạo mới.
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>