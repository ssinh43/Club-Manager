@model List<ClubManager.Areas.Admin.Controllers.EventController.EventItemViewModel>

@{
    ViewData["Title"] = "Danh sách sự kiện";
}

<style>
    .event-page-wrap {
        margin-left: 316px;
        padding: 76px 20px 20px 8px;
    }

    .event-main-title {
        font-size: 26px;
        font-weight: 600;
        color: #012970;
        margin-bottom: 10px;
        line-height: 1.25;
    }

    @@media (max-width: 1199px) {
        .event-page-wrap {
            margin-left: 0;
            padding: 76px 12px 20px 12px;
        }
    }
</style>

<div class="event-page-wrap">
    <div class="mb-3">
        <h1 class="event-main-title">Danh sách sự kiện</h1>
        <a asp-area="Admin" asp-controller="Event" asp-action="Create" class="btn btn-success">
            <i class="bi bi-file-earmark-plus me-1"></i> Thêm sự kiện
        </a>
    </div>

    <section class="section">
        <div class="card">
            <div class="card-body pt-3">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">@TempData["Success"]</div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">@TempData["Error"]</div>
                }

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 70px;">ID</th>
                                <th style="min-width: 180px;">Tên sự kiện</th>
                                <th style="width: 160px;">Thời gian</th>
                                <th style="min-width: 150px;">Địa điểm</th>
                                <th style="min-width: 180px;">Mô tả</th>
                                <th class="text-center" style="width: 110px;">Chức năng</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Count > 0)
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.Id</td>
                                        <td class="text-primary fw-medium">@item.EventName</td>
                                        <td>@(item.EventDate.HasValue ? item.EventDate.Value.ToString("dd/MM/yyyy HH:mm") : "-")</td>
                                        <td>@(item.Location ?? "-")</td>
                                        <td>@(item.Description ?? "-")</td>
                                        <td class="text-center text-nowrap">
                                            <a asp-area="Admin" asp-controller="Event" asp-action="Edit" asp-route-id="@item.Id"
                                               class="btn btn-primary btn-sm" title="Chỉnh sửa">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>

                                            <form asp-area="Admin" asp-controller="Event" asp-action="Delete" method="post"
                                                  class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa sự kiện này?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="btn btn-danger btn-sm" title="Xóa">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-4">
                                        Chưa có dữ liệu sự kiện. Bấm "Thêm sự kiện" để tạo mới.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>
</div>