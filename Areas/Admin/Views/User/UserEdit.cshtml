@model clubmanager.Models.tblUser

<main id="main" class="main">
    <div class="pagetitle">
        <h2>Edit an account</h2>
    </div>
    <div class="container shadow p-5">
        <form method="post" asp-action="UserEdit">
            <div class="form-row">
                <input type="hidden" asp-for="UserID" />
                <div class="form-group col-md-6 mb-3">
                    <label>Username</label>
                    <input type="text" class="form-control" asp-for="UserName" placeholder="Username...">
                    <span asp-validation-for="UserName" class="text-danger"></span>
                </div>

                <div class="form-group col-md-6 mb-3">
                    <label>Email</label>
                    <input type="email" class="form-control" asp-for="Email" placeholder="Email...">
                </div>

                <div class="form-group col-md-6 mb-3">
                    <label>Password</label>
                    <label>New password <small class="text-muted">(leave blank to keep the old one)</small></label>
                </div>

                <div class="form-group col-md-6 mb-3">
                    <label>
                        @Html.CheckBox("IsActive", Model.IsActive)
                        Active
                    </label>
                </div>
            </div>

            <a asp-controller="User" asp-action="UserList" class="btn btn-lg btn-warning p-2">
                <i class="bi bi-arrow-left-circle"></i> Go back
            </a>
            <button type="submit" class="btn btn-lg btn-primary p-2">
                <i class="bi bi-file-plus-fill"></i> Save information
            </button>
        </form>
    </div>
</main>