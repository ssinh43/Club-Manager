<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">

    <title>@ViewData["Title"] - Sport Club Management</title>

    <meta name="description" content="Hệ thống quản lý câu lạc bộ thể thao trường học">
    <meta name="keywords" content="quản lý câu lạc bộ, thể thao, trường học, sinh viên">

    <!-- Favicons -->
    <link href="~/assets/img/favicon.png" rel="icon">
    <link href="~/assets/img/apple-touch-icon.png" rel="apple-touch-icon">

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com" rel="preconnect">
    <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700;900&family=Poppins:wght@300;400;500;600;700;800&display=swap"
          rel="stylesheet">

    <!-- Vendor CSS -->
    <link href="~/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
    <link href="~/assets/vendor/aos/aos.css" rel="stylesheet">
    <link href="~/assets/vendor/glightbox/css/glightbox.min.css" rel="stylesheet">
    <link href="~/assets/vendor/swiper/swiper-bundle.min.css" rel="stylesheet">

    <!-- Main CSS -->
    <link href="~/assets/css/main.css" rel="stylesheet">
    <link href="~/css/club-integration.css" rel="stylesheet">

    @await RenderSectionAsync("Styles", required: false)

</head>

<body class="index-page">

    <!-- Header / Menu -->
    @await Component.InvokeAsync("MenuView")

    <!-- Main Content -->
    <main id="main" class="main">

        @RenderBody()

    </main>

    <!-- Footer -->
    <footer id="footer" class="footer dark-background">

        <div class="container">
            <div class="row gy-4">

                <!-- About -->
                <div class="col-lg-4 col-md-6">
                    <div class="footer-content">

                        <a href="/" class="logo d-flex align-items-center mb-3">
                            <span class="sitename">SPORT CLUB</span>
                        </a>

                        <p>
                            Hệ thống quản lý câu lạc bộ thể thao trường học.
                            Kết nối sinh viên có cùng đam mê thể thao,
                            xây dựng môi trường học tập và rèn luyện năng động.
                        </p>

                        <div class="social-links d-flex gap-3">
                            <a href="#"><i class="bi bi-facebook"></i></a>
                            <a href="#"><i class="bi bi-instagram"></i></a>
                            <a href="#"><i class="bi bi-youtube"></i></a>
                            <a href="#"><i class="bi bi-tiktok"></i></a>
                        </div>

                    </div>
                </div>

                <!-- Quick Links -->
                <div class="col-lg-2 col-md-6">
                    <div class="footer-links">

                        <h4>Liên kết</h4>

                        <ul>
                            <li><a href="/"><i class="bi bi-chevron-right"></i> Trang chủ</a></li>
                            <li><a href="/Home/About"><i class="bi bi-chevron-right"></i> Giới thiệu</a></li>
                            <li><a href="/Club"><i class="bi bi-chevron-right"></i> Câu lạc bộ</a></li>
                            <li><a href="/Event"><i class="bi bi-chevron-right"></i> Sự kiện</a></li>
                            <li><a href="/News"><i class="bi bi-chevron-right"></i> Tin tức</a></li>
                        </ul>

                    </div>
                </div>

                <!-- Clubs -->
                <div class="col-lg-2 col-md-6">
                    <div class="footer-links">

                        <h4>Câu lạc bộ</h4>

                        <ul>
                            <li><a href="#"><i class="bi bi-chevron-right"></i> Bóng đá</a></li>
                            <li><a href="#"><i class="bi bi-chevron-right"></i> Bóng chuyền</a></li>
                            <li><a href="#"><i class="bi bi-chevron-right"></i> Cầu lông</a></li>
                            <li><a href="#"><i class="bi bi-chevron-right"></i> Bóng rổ</a></li>
                            <li><a href="#"><i class="bi bi-chevron-right"></i> Võ thuật</a></li>
                        </ul>

                    </div>
                </div>

                <!-- Contact -->
                <div class="col-lg-4 col-md-6">
                    <div class="footer-contact">

                        <h4>Thông tin liên hệ</h4>

                        <div class="contact-item">
                            <div class="contact-icon">
                                <i class="bi bi-geo-alt"></i>
                            </div>
                            <div class="contact-info">
                                <p>Trường học - Việt Nam</p>
                            </div>
                        </div>

                        <div class="contact-item">
                            <div class="contact-icon">
                                <i class="bi bi-telephone"></i>
                            </div>
                            <div class="contact-info">
                                <p>0123 456 789</p>
                            </div>
                        </div>

                        <div class="contact-item">
                            <div class="contact-icon">
                                <i class="bi bi-envelope"></i>
                            </div>
                            <div class="contact-info">
                                <p>sportclub@gmail.com</p>
                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </div>

        <!-- Footer Bottom -->
        <div class="footer-bottom mt-4">

            <div class="container">

                <div class="row align-items-center">

                    <div class="col-lg-6">
                        <div class="copyright">
                            <p>
                                © <strong class="px-1 sitename">SPORT CLUB</strong>
                                <span>All Rights Reserved</span>
                            </p>
                        </div>
                    </div>

                    <div class="col-lg-6">
                        <div class="footer-bottom-links">
                            <a href="#">Chính sách bảo mật</a>
                            <a href="#">Điều khoản sử dụng</a>
                        </div>
                    </div>

                </div>

            </div>

        </div>

    </footer>

    <!-- Scroll Top -->
    <a href="#" id="scroll-top"
       class="scroll-top d-flex align-items-center justify-content-center">
        <i class="bi bi-arrow-up-short"></i>
    </a>

    <!-- Preloader -->
    <div id="preloader"></div>

    <!-- Vendor JS -->
    <script src="~/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/vendor/php-email-form/validate.js"></script>
    <script src="~/assets/vendor/aos/aos.js"></script>
    <script src="~/assets/vendor/purecounter/purecounter_vanilla.js"></script>
    <script src="~/assets/vendor/imagesloaded/imagesloaded.pkgd.min.js"></script>
    <script src="~/assets/vendor/isotope-layout/isotope.pkgd.min.js"></script>
    <script src="~/assets/vendor/glightbox/js/glightbox.min.js"></script>
    <script src="~/assets/vendor/swiper/swiper-bundle.min.js"></script>

    <!-- Main JS -->
    <script src="~/assets/js/main.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>