@{
    ViewData["Title"] = "Trang chủ";
}

<section id="hero" class="hero section light-background">

    <div class="container" data-aos="fade-up">

        <div class="text-center mb-5">
            <h1>
                KẾT NỐI ĐAM MÊ
                <span class="text-success">CHINH PHỤC THỂ THAO</span>
            </h1>

            <p class="fs-5">
                Khám phá các câu lạc bộ thể thao và tham gia
                cộng đồng sinh viên năng động tại trường học.
            </p>
        </div>

        <div class="row align-items-center gy-4">

            <div class="col-lg-7">

                <img src="~/assets/img/about/trangchu.jpg"
                     class="img-fluid rounded-4"
                     alt="Hoạt động thể thao trường học">

            </div>

            <div class="col-lg-5">

                <div class="p-4 bg-white rounded-4 shadow-sm">

                    <h3 class="mb-3">
                        Tham gia cộng đồng thể thao
                    </h3>

                    <p>
                        Rèn luyện sức khỏe, phát triển kỹ năng
                        và kết nối với những người có cùng đam mê.
                    </p>

                    <ul class="list-unstyled">

                        <li class="mb-3">
                            <i class="bi bi-check-circle-fill text-success"></i>
                            Khám phá các câu lạc bộ
                        </li>

                        <li class="mb-3">
                            <i class="bi bi-check-circle-fill text-success"></i>
                            Đăng ký tham gia trực tuyến
                        </li>

                        <li class="mb-3">
                            <i class="bi bi-check-circle-fill text-success"></i>
                            Theo dõi sự kiện thể thao
                        </li>

                        <li class="mb-3">
                            <i class="bi bi-check-circle-fill text-success"></i>
                            Quản lý hoạt động và điểm danh
                        </li>

                    </ul>

                    <a href="/Club" class="btn btn-success mt-3">
                        Khám phá câu lạc bộ
                    </a>

                </div>

            </div>

        </div>

    </div>

</section>

<section id="clubs" class="services section">

    <div class="container">

        <div class="text-center mb-5">
            <h2>CÂU LẠC BỘ THỂ THAO</h2>
            <p>Khám phá những câu lạc bộ nổi bật tại trường</p>
        </div>

        <div class="row gy-4">

            <div class="col-lg-3 col-md-6">
                <div class="service-item text-center p-4 shadow-sm rounded-4">
                    <i class="bi bi-dribbble fs-1 text-success"></i>
                    <h4>Bóng đá</h4>
                    <p>Rèn luyện thể lực và tinh thần đồng đội.</p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="service-item text-center p-4 shadow-sm rounded-4">
                    <i class="bi bi-trophy fs-1 text-success"></i>
                    <h4>Bóng rổ</h4>
                    <p>Phát triển kỹ năng và khả năng phối hợp.</p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="service-item text-center p-4 shadow-sm rounded-4">
                    <i class="bi bi-lightning fs-1 text-success"></i>
                    <h4>Cầu lông</h4>
                    <p>Nâng cao sự nhanh nhẹn và sức bền.</p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="service-item text-center p-4 shadow-sm rounded-4">
                    <i class="bi bi-people fs-1 text-success"></i>
                    <h4>Bóng chuyền</h4>
                    <p>Gắn kết thành viên và tinh thần tập thể.</p>
                </div>
            </div>

        </div>

    </div>

</section>