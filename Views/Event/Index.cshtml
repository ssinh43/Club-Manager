@model IEnumerable<clubmanager.Models.tblEvent>

@{
    Layout = "_LayoutNice";
    ViewData["Title"] = "Danh sách sự kiện";
}

<div class="container mt-4 mb-5">

    <h2 class="mb-4">Danh sách sự kiện</h2>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-info">
            @TempData["Message"]
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="row">

            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">

                    <div class="card h-100 shadow-sm">

                        <div class="card-body">

                            <h5 class="card-title">
                                @item.EventName
                            </h5>

                            <p class="card-text">
                                @item.Description
                            </p>

                            <p>
                                <strong>Thời gian:</strong>
                                @item.StartDate.ToString("dd/MM/yyyy HH:mm")
                            </p>

                            <p>
                                <strong>Địa điểm:</strong>
                                @item.Location
                            </p>

                            <p>
                                <strong>Số lượng tối đa:</strong>
                                @(item.MaxParticipants?.ToString() ?? "Không giới hạn")
                            </p>

                            <a asp-controller="Event"
                               asp-action="Details"
                               asp-route-id="@item.EventID"
                               class="btn btn-info mb-2">
                                Chi tiết
                            </a>

                            <form asp-controller="Registration"
                                  asp-action="Register"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="eventID"
                                       value="@item.EventID" />

                                <button type="submit"
                                        class="btn btn-primary">
                                    Đăng ký tham gia
                                </button>

                            </form>

                        </div>

                    </div>

                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">
            Hiện chưa có sự kiện nào.
        </div>
    }

    <a asp-controller="Registration"
       asp-action="My"
       class="btn btn-success mt-3">
        Sự kiện đã đăng ký
    </a>

</div>