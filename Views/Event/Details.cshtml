@model clubmanager.Models.tblEvent

@{
    Layout = "_LayoutNice";
    ViewData["Title"] = "Chi tiết sự kiện";
}

<div class="container mt-4 mb-5">

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-info">
            @TempData["Message"]
        </div>
    }

    <div class="card shadow-sm">

        <div class="card-body">

            <h2 class="mb-4">@Model.EventName</h2>

            <hr />

            <h5>Thông tin sự kiện</h5>

            <p class="mt-3">
                <strong>Mô tả:</strong>
            </p>

            <p>@Model.Description</p>

            <p>
                <strong>Thời gian bắt đầu:</strong>
                @Model.StartDate.ToString("dd/MM/yyyy HH:mm")
            </p>

            <p>
                <strong>Thời gian kết thúc:</strong>
                @Model.EndDate.ToString("dd/MM/yyyy HH:mm")
            </p>

            <p>
                <strong>Địa điểm:</strong>
                @Model.Location
            </p>

            <p>
                <strong>Số lượng tối đa:</strong>
                @(Model.MaxParticipants?.ToString() ?? "Không giới hạn")
            </p>

            <hr />

            @if (Model.StartDate > DateTime.Now)
            {
                <form asp-controller="Registration"
                      asp-action="Register"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="eventID"
                           value="@Model.EventID" />

                    <button type="submit"
                            class="btn btn-primary">
                        Đăng ký tham gia sự kiện
                    </button>

                </form>
            }
            else
            {
                <div class="alert alert-warning">
                    Sự kiện đã bắt đầu hoặc đã kết thúc.
                </div>
            }

            <a asp-controller="Event"
               asp-action="Index"
               class="btn btn-secondary mt-3">
                Quay lại danh sách
            </a>

        </div>

    </div>

</div>