@model List<clubmanager.Models.Club>
@{
    ViewData["Title"] = "Danh sách CLB";
}

<section class="section">
    <div class="container">
        <div class="page-heading">
            <div>
                <span class="eyebrow">SPORT CLUB</span>
                <h1>Danh sách câu lạc bộ</h1>
                <p>Khám phá các câu lạc bộ đang hoạt động và tìm nơi phù hợp với bạn.</p>
            </div>
            <a asp-action="Joined" class="btn btn-outline-success">
                <i class="bi bi-people me-1"></i> CLB đã tham gia
            </a>
        </div>

        @if (Model.Count == 0)
        {
            <div class="panel empty-state">
                <i class="bi bi-search text-success fs-1"></i>
                <h2 class="mt-3">Chưa có câu lạc bộ hoạt động</h2>
                <p class="mb-0">Vui lòng quay lại sau để khám phá các câu lạc bộ mới.</p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var club in Model)
                {
                    <div class="col-md-6 col-xl-4">
                        <article class="panel h-100 mb-0">
                            <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                                <span class="club-letter">@club.Name[..1]</span>
                                <span class="status-pill status-live">Đang hoạt động</span>
                            </div>
                            <p class="eyebrow mb-1">@club.Sport</p>
                            <h2>@club.Name</h2>
                            <p class="text-muted">
                                @(string.IsNullOrWhiteSpace(club.Description) ? "Câu lạc bộ thể thao dành cho học sinh, sinh viên." : club.Description)
                            </p>
                            <div class="small text-muted mb-3">
                                <div><i class="bi bi-people me-2"></i>Sức chứa tối đa @club.Capacity thành viên</div>
                                @if (!string.IsNullOrWhiteSpace(club.Location))
                                {
                                    <div class="mt-2"><i class="bi bi-geo-alt me-2"></i>@club.Location</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(club.Schedule))
                                {
                                    <div class="mt-2"><i class="bi bi-calendar-week me-2"></i>@club.Schedule</div>
                                }
                            </div>
                            <a asp-controller="ClubRegistration" asp-action="Join" asp-route-clubId="@club.Id" class="btn btn-success">
                                Đăng ký tham gia <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </article>
                    </div>
                }
            </div>
        }
    </div>
</section>
